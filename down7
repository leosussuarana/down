        tk.Label(f_ytdlp, text="INSTALADO" if tem_ytdlp else "NÃO ENCONTRADO", font=("Segoe UI", 9, "bold"), bg=COR_PRETO, fg=cor_y).pack(side=tk.RIGHT)
        
