def obter_pasta_downloads_windows() -> str:
    user_profile = os.environ.get('USERPROFILE')
    if user_profile:
        pasta_dl = os.path.join(user_profile, "Downloads")
        if os.path.exists(pasta_dl): return pasta_dl
    return os.path.join(os.path.expanduser("~"), "Downloads")

def centralizar_janela(janela, largura, altura):
    janela.geometry(f"{largura}x{altura}")
    janela.update_idletasks()
    sw = janela.winfo_screenwidth()
    sh = janela.winfo_screenheight()
    x = (sw - largura) // 2
    y = (sh - altura) // 2
    janela.geometry(f"+{x}+{y}")

def obter_comando(nome_bin: str) -> str:
    ext = ".exe" if os.name == "nt" and not nome_bin.lower().endswith(".exe") else ""
    nome_arq = f"{nome_bin}{ext}"
    locais = [
        os.path.join(PASTA_APP, nome_arq),
        os.path.join(PASTA_BUNDLE, nome_arq),
        os.path.join(os.getcwd(), nome_arq)
    ]
    for caminho in locais:
        if os.path.exists(caminho):
            return caminho
    caminho_sys = shutil.which(nome_bin) or shutil.which(nome_arq)
    return caminho_sys if caminho_sys else nome_arq

def checar_executavel(nome_bin: str) -> bool:
    ext = ".exe" if os.name == "nt" and not nome_bin.lower().endswith(".exe") else ""
    nome_arq = f"{nome_bin}{ext}"
    locais = [
        os.path.join(PASTA_APP, nome_arq),
        os.path.join(PASTA_BUNDLE, nome_arq),
        os.path.join(os.getcwd(), nome_arq)
    ]
    for caminho in locais:
        if os.path.exists(caminho):
            return True
    return bool(shutil.which(nome_bin) or shutil.which(nome_arq))

def abrir_pasta_no_explorer(caminho_pasta: str):
    try:
        caminho_norm = os.path.normpath(caminho_pasta)
        if os.path.exists(caminho_norm):
            if os.name == 'nt':
                os.startfile(caminho_norm)
            else:
                subprocess.Popen(['xdg-open', caminho_norm])
    except Exception:
        pass

#====================================================
# MOTOR CENTRAL DE EXECUÇÃO DE PROCESSOS (ALVO 3)
#====================================================
def executar_processo(
    cmd: list, 
    flags_criacao: int, 
    capturar_saida: bool = True, 
    on_linha=None, 
    is_cancelado_fn=None, 
    on_start=None, 
    timeout: int = None, 
    on_tick=None
) -> tuple:
    """
    Motor central unificado para execução segura de processos externos.
    Retorna (finalizado_com_sucesso sem timeout/cancel, returncode).
    """
    try:
        out_dest = subprocess.PIPE if capturar_saida else subprocess.DEVNULL
        err_dest = subprocess.STDOUT if capturar_saida else subprocess.DEVNULL
        
        proc = subprocess.Popen(
            cmd,
            stdout=out_dest,
            stderr=err_dest,
            stdin=subprocess.DEVNULL,
            text=True if capturar_saida else False,
            encoding='utf-8' if capturar_saida else None,
            errors='ignore' if capturar_saida else None,
            bufsize=1 if capturar_saida else -1,
            creationflags=flags_criacao
        )
    except Exception:
        return False, -1

    if on_start:
        on_start(proc)

    lendo = [True]
    t_leitura = None

    if capturar_saida:
        def ler_stdout():
            try:
                for linha in iter(proc.stdout.readline, ''):
                    if not lendo[0] or (is_cancelado_fn and is_cancelado_fn()):
                        break
                    if linha and on_linha:
                        on_linha(linha)
            except Exception:
                pass
            finally:
                try: proc.stdout.close()
                except: pass

        t_leitura = threading.Thread(target=ler_stdout, daemon=True)
        t_leitura.start()

    expirado = False
    
    if timeout is not None and timeout > 0:
        for seg in range(timeout, 0, -1):
            if is_cancelado_fn and is_cancelado_fn():
                break
            if proc.poll() is not None:
                break
            if on_tick:
                on_tick(seg)
            
            # Loop curtos para responsividade a cancelamento rápido
            for _ in range(10):
                if (is_cancelado_fn and is_cancelado_fn()) or proc.poll() is not None:
                    break
                time.sleep(0.1)
        else:
            if proc.poll() is None:
                expirado = True
    else:
        while proc.poll() is None:
            if is_cancelado_fn and is_cancelado_fn():
                break
            time.sleep(0.1)

    lendo[0] = False
    cancelado = is_cancelado_fn() if is_cancelado_fn else False

    if cancelado or expirado:
        try: proc.kill()
        except Exception: pass
        if t_leitura: t_leitura.join(timeout=0.5)
        return False, proc.returncode if proc.returncode is not None else -1

    proc.wait()
    if t_leitura: t_leitura.join(timeout=0.5)
    return True, proc.returncode

def instalar_motores_sistema(tem_ytdlp: bool, tem_ffmpeg: bool, tem_deno: bool, forcar_limpeza: bool=False, cb_log=None):
    try:
        user_agent = "Mozilla/5.0 (Windows NT 10.0; Win64; x64)"
        motores = ["yt-dlp.exe", "ffmpeg.exe", "deno.exe"]

        if forcar_limpeza:
            if cb_log: cb_log("Limpando arquivos antigos...\n")
            for motor in motores:
                caminho = os.path.join(PASTA_APP, motor)
                if os.path.exists(caminho):
                    try:
                        os.remove(caminho)
                        if cb_log: cb_log(f" - {motor} removido.\n")
                    except Exception as e:
                        if cb_log: cb_log(f" - Falha ao remover {motor}: {e}\n")
            if cb_log: cb_log("\nIniciando download das versões mais recentes...\n")
            tem_ytdlp = tem_ffmpeg = tem_deno = False

        if not tem_ytdlp:
            if cb_log: cb_log("[1/3] Baixando yt-dlp.exe...\n")
            url_ytdlp = "https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp.exe"
            with urllib.request.urlopen(urllib.request.Request(url_ytdlp, headers={"User-Agent": user_agent}), timeout=30) as resp, open(os.path.join(PASTA_APP, "yt-dlp.exe"), 'wb') as out_f:
                shutil.copyfileobj(resp, out_f)
            if cb_log: cb_log("yt-dlp baixado!\n")

        if not tem_ffmpeg:
            if cb_log: cb_log("[2/3] Baixando e extraindo ffmpeg...\n")
            url_ffmpeg = "https://www.gyan.dev/ffmpeg/builds/ffmpeg-release-essentials.zip"
            zip_tmp = os.path.join(PASTA_APP, "ffmpeg_tmp.zip")
            with urllib.request.urlopen(urllib.request.Request(url_ffmpeg, headers={"User-Agent": user_agent}), timeout=60) as resp, open(zip_tmp, 'wb') as out_f:
                shutil.copyfileobj(resp, out_f)
            with zipfile.ZipFile(zip_tmp, 'r') as z:
                for arq in z.namelist():
                    if arq.endswith("ffmpeg.exe"):
                        with z.open(arq) as zf, open(os.path.join(PASTA_APP, "ffmpeg.exe"), 'wb') as df: shutil.copyfileobj(zf, df)
                        break
            if os.path.exists(zip_tmp): os.remove(zip_tmp)
            if cb_log: cb_log("ffmpeg baixado!\n")

        if not tem_deno:
            if cb_log: cb_log("[3/3] Baixando e extraindo deno.exe...\n")
            url_deno = "https://github.com/denoland/deno/releases/latest/download/deno-x86_64-pc-windows-msvc.zip"
            zip_deno = os.path.join(PASTA_APP, "deno_tmp.zip")
            with urllib.request.urlopen(urllib.request.Request(url_deno, headers={"User-Agent": user_agent}), timeout=60) as resp, open(zip_deno, 'wb') as out_f:
                shutil.copyfileobj(resp, out_f)
            with zipfile.ZipFile(zip_deno, 'r') as z:
                z.extract("deno.exe", PASTA_APP)
            if os.path.exists(zip_deno): os.remove(zip_deno)
            if cb_log: cb_log("deno baixado!\n")

        return True, ""
    except Exception as e:
        return False, str(e)

